<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action -->
    <record id="action_report_all_recipes" model="ir.actions.report">
        <field name="name">All Recipes / جميع الوصفات</field>
        <field name="model">restaurant.recipe</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_recipe_costing.report_all_recipes</field>
        <field name="report_file">pos_recipe_costing.report_all_recipes</field>
        <field name="print_report_name">'Recipes_Guide'</field>
    </record>

    <!-- Report Template -->
    <template id="report_all_recipes">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mb-3">
                        <h2 style="margin-bottom: 5px;">Recipe Guide / دليل الوصفات</h2>
                        <small class="text-muted"><t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></small>
                    </div>

                    <!-- Rows of two cards, so both columns fill together (two halves left one side empty
                         when the short recipes came first). Cards are right-to-left: Arabic names with
                         brackets, e.g. "اركيلة انكليزي (الماني)", printed reversed in a left-to-right page. -->
                    <t t-set="recipes_list" t-value="docs.sorted(lambda r: r.name or '')"/>
                    <table style="width: 100%; font-size: 9pt; border-collapse: separate; border-spacing: 8px 6px;">
                        <t t-foreach="range(0, len(recipes_list), 2)" t-as="row_start">
                            <tr style="page-break-inside: avoid;">
                                <t t-foreach="recipes_list[row_start:row_start + 2]" t-as="recipe">
                                    <td dir="rtl" style="width: 50%; vertical-align: top; border: 1px solid #ddd; border-radius: 5px; padding: 6px 8px; text-align: right;">
                                        <div style="border-bottom: 1px solid #eee; padding-bottom: 3px; margin-bottom: 4px;">
                                            <strong style="font-size: 10pt;"><t t-esc="recipe.name"/></strong>
                                            <t t-if="recipe.product_id.list_price">
                                                <span class="text-muted" style="float: left; font-size: 8pt;" dir="ltr">
                                                    <t t-esc="'{:,.0f}'.format(recipe.product_id.list_price)"/> <t t-esc="recipe.currency_id.symbol"/>
                                                </span>
                                            </t>
                                        </div>
                                        <t t-if="recipe.ingredient_line_ids">
                                            <table style="width: 100%; font-size: 8pt; line-height: 1.4;">
                                                <t t-foreach="recipe.ingredient_line_ids" t-as="line">
                                                    <tr>
                                                        <td style="text-align: right;"><t t-esc="line.product_id.name"/></td>
                                                        <td style="text-align: left; white-space: nowrap; width: 30%;" dir="ltr">
                                                            <t t-esc="'%g' % round(line.quantity, 3)"/> <t t-esc="line.uom_id.name"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </table>
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted" style="font-size: 8pt;">No ingredients / لا توجد مكونات</span>
                                        </t>
                                    </td>
                                </t>
                                <td t-if="row_start + 1 &gt;= len(recipes_list)" style="width: 50%;"/>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
