<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== -->
    <!-- Module Category -->
    <!-- ===================== -->
    <record id="module_category_recipe_costing" model="ir.module.category">
        <field name="name">Recipe &amp; Costing</field>
        <field name="description">Manage recipes, food costing, and inventory for restaurants</field>
        <field name="sequence">35</field>
    </record>

    <!-- ===================== -->
    <!-- Security Groups -->
    <!-- ===================== -->

    <!-- Recipe User: Read access to recipes, ingredients, dashboard -->
    <record id="group_recipe_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Access to view recipes, ingredients, and dashboard. Can record stocktakes and waste.</field>
        <field name="category_id" ref="module_category_recipe_costing"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <!-- Recipe Manager: Full access to all features -->
    <record id="group_recipe_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Full access to create, edit, and delete recipes. Access to settings and configuration.</field>
        <field name="category_id" ref="module_category_recipe_costing"/>
        <field name="implied_ids" eval="[(4, ref('group_recipe_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
