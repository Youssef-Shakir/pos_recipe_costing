<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recipe_dashboard_form" model="ir.ui.view">
        <field name="name">recipe.dashboard.form</field>
        <field name="model">recipe.dashboard</field>
        <field name="arch" type="xml">
            <form string="Recipe Dashboard" create="false" edit="false" delete="false">
                <sheet>
                    <!-- Dashboard Styles -->
                    <style>
                        .recipe-dashboard {
                            background: #f5f5f7;
                            min-height: 100vh;
                            padding: 32px;
                            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, sans-serif;
                        }
                        .dashboard-header {
                            margin-bottom: 32px;
                        }
                        .dashboard-title {
                            font-size: 34px;
                            font-weight: 700;
                            color: #1d1d1f;
                            margin: 0 0 4px 0;
                            letter-spacing: -0.5px;
                        }
                        .dashboard-subtitle {
                            font-size: 17px;
                            color: #86868b;
                            margin: 0;
                        }
                        /* Metric Cards */
                        .metric-card {
                            background: #fff;
                            border-radius: 16px;
                            padding: 20px;
                            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
                            transition: all 0.2s ease;
                            cursor: pointer;
                            height: 100%;
                            border: 1px solid transparent;
                        }
                        .metric-card:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
                            border-color: #e5e5e5;
                        }
                        .metric-card-sm {
                            border-radius: 12px;
                            padding: 16px;
                            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
                        }
                        .metric-label {
                            font-size: 11px;
                            font-weight: 600;
                            color: #86868b;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                            margin-bottom: 8px;
                            display: flex;
                            align-items: center;
                            gap: 6px;
                        }
                        .metric-value {
                            font-size: 34px;
                            font-weight: 700;
                            color: #1d1d1f;
                            line-height: 1;
                        }
                        .metric-value-sm {
                            font-size: 24px;
                            font-weight: 600;
                        }
                        /* Color variants */
                        .text-warning { color: #ff9500 !important; }
                        .text-danger { color: #ff3b30 !important; }
                        .text-success { color: #34c759 !important; }
                        .text-primary { color: #007aff !important; }
                        .text-purple { color: #5856d6 !important; }
                        .text-muted { color: #86868b !important; }
                        /* Action Cards */
                        .action-card {
                            background: #fff;
                            border-radius: 16px;
                            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
                            overflow: hidden;
                            height: 100%;
                            display: flex;
                            flex-direction: column;
                        }
                        .action-card-header {
                            padding: 20px 20px 16px;
                            border-bottom: 1px solid #f0f0f0;
                            display: flex;
                            align-items: center;
                            gap: 10px;
                        }
                        .action-card-title {
                            font-size: 17px;
                            font-weight: 600;
                            color: #1d1d1f;
                            margin: 0;
                        }
                        .action-card-body {
                            padding: 16px 20px 20px;
                            flex: 1;
                            display: flex;
                            flex-direction: column;
                        }
                        /* Buttons */
                        .btn-primary-action {
                            display: block;
                            width: 100%;
                            background: #007aff;
                            color: #fff !important;
                            border: none;
                            border-radius: 10px;
                            padding: 14px 20px;
                            font-size: 15px;
                            font-weight: 600;
                            margin-bottom: 12px;
                            cursor: pointer;
                            text-align: center;
                            transition: all 0.15s ease;
                        }
                        .btn-primary-action:hover {
                            background: #0066d6;
                            transform: scale(1.01);
                        }
                        .btn-green { background: #34c759 !important; }
                        .btn-green:hover { background: #2db14f !important; }
                        .btn-orange { background: #ff9500 !important; }
                        .btn-orange:hover { background: #e68600 !important; }
                        .btn-red { background: #ff3b30 !important; }
                        .btn-red:hover { background: #e6352b !important; }
                        .btn-purple { background: #5856d6 !important; }
                        .btn-purple:hover { background: #4d4bc2 !important; }
                        .btn-secondary-action {
                            display: block;
                            width: 100%;
                            background: #f5f5f7;
                            color: #1d1d1f !important;
                            border: none;
                            border-radius: 10px;
                            padding: 12px 20px;
                            font-size: 15px;
                            font-weight: 600;
                            margin-bottom: 8px;
                            cursor: pointer;
                            text-align: center;
                            transition: all 0.15s ease;
                        }
                        .btn-secondary-action:hover {
                            background: #e8e8ed;
                        }
                        .btn-link-action {
                            display: flex;
                            width: 100%;
                            background: transparent;
                            color: #007aff !important;
                            border: none;
                            padding: 12px 4px;
                            font-size: 15px;
                            font-weight: 500;
                            cursor: pointer;
                            text-align: left;
                            border-radius: 8px;
                            transition: all 0.1s ease;
                            align-items: center;
                            gap: 8px;
                        }
                        .btn-link-action:hover {
                            background: #f5f5f7;
                        }
                        .btn-link-action i {
                            font-size: 14px;
                            width: 20px;
                            text-align: center;
                        }
                        .link-separator {
                            height: 1px;
                            background: #f0f0f0;
                            margin: 8px 0;
                        }
                        /* Consumption Section */
                        .consumption-card {
                            background: #fff;
                            border-radius: 16px;
                            padding: 24px;
                            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
                            margin-bottom: 24px;
                        }
                        .consumption-title {
                            font-size: 20px;
                            font-weight: 600;
                            color: #1d1d1f;
                            margin: 0 0 20px 0;
                            display: flex;
                            align-items: center;
                            gap: 10px;
                        }
                        .consumption-stat {
                            cursor: pointer;
                            padding: 12px;
                            border-radius: 12px;
                            transition: all 0.15s ease;
                        }
                        .consumption-stat:hover {
                            background: #f5f5f7;
                        }
                        .consumption-label {
                            font-size: 11px;
                            font-weight: 600;
                            color: #86868b;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                            margin-bottom: 4px;
                        }
                        .consumption-value {
                            font-size: 28px;
                            font-weight: 700;
                            color: #1d1d1f;
                        }
                    </style>

                    <div class="recipe-dashboard">
                        <!-- Header -->
                        <div class="dashboard-header">
                            <h1 class="dashboard-title">Recipe &amp; Costing</h1>
                            <p class="dashboard-subtitle">Overview of your kitchen operations</p>
                        </div>

                        <!-- Primary Metrics - Key Numbers -->
                        <div class="row g-3 mb-4">
                            <!-- Total Recipes -->
                            <div class="col-lg-2 col-md-4 col-6">
                                <button name="action_view_recipes" type="object" class="w-100 border-0 bg-transparent p-0">
                                    <div class="metric-card">
                                        <div class="metric-label">
                                            <i class="fa fa-book"/>
                                            Recipes
                                        </div>
                                        <div class="metric-value">
                                            <field name="recipe_count" readonly="1"/>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <!-- Ingredients -->
                            <div class="col-lg-2 col-md-4 col-6">
                                <button name="action_view_ingredients" type="object" class="w-100 border-0 bg-transparent p-0">
                                    <div class="metric-card">
                                        <div class="metric-label">
                                            <i class="fa fa-leaf"/>
                                            Ingredients
                                        </div>
                                        <div class="metric-value">
                                            <field name="ingredient_count" readonly="1"/>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <!-- Menu Items -->
                            <div class="col-lg-2 col-md-4 col-6">
                                <button name="action_view_pos_products" type="object" class="w-100 border-0 bg-transparent p-0">
                                    <div class="metric-card">
                                        <div class="metric-label">
                                            <i class="fa fa-cutlery"/>
                                            Menu Items
                                        </div>
                                        <div class="metric-value">
                                            <field name="pos_product_count" readonly="1"/>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <!-- Missing Recipes - Warning -->
                            <div class="col-lg-2 col-md-4 col-6">
                                <button name="action_products_without_recipe" type="object" class="w-100 border-0 bg-transparent p-0">
                                    <div class="metric-card">
                                        <div class="metric-label text-warning">
                                            <i class="fa fa-exclamation-circle"/>
                                            No Recipe
                                        </div>
                                        <div class="metric-value text-warning">
                                            <field name="products_without_recipe" readonly="1"/>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <!-- Avg Food Cost -->
                            <div class="col-lg-2 col-md-4 col-6">
                                <div class="metric-card" style="cursor: default;">
                                    <div class="metric-label text-primary">
                                        <i class="fa fa-percent"/>
                                        Avg Food Cost
                                    </div>
                                    <div class="metric-value text-primary">
                                        <field name="avg_food_cost" readonly="1" widget="float" digits="[3,1]"/>%
                                    </div>
                                </div>
                            </div>
                            <!-- High Cost - Danger -->
                            <div class="col-lg-2 col-md-4 col-6">
                                <button name="action_low_margin_recipes" type="object" class="w-100 border-0 bg-transparent p-0">
                                    <div class="metric-card">
                                        <div class="metric-label text-danger">
                                            <i class="fa fa-arrow-up"/>
                                            High Cost
                                        </div>
                                        <div class="metric-value text-danger">
                                            <field name="low_margin_count" readonly="1"/>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                        <!-- Secondary Metrics Row -->
                        <div class="row g-3 mb-4">
                            <div class="col-lg-2 col-md-4 col-6">
                                <button name="action_variants_without_recipe" type="object" class="w-100 border-0 bg-transparent p-0">
                                    <div class="metric-card metric-card-sm">
                                        <div class="metric-label text-warning">Variants Missing</div>
                                        <div class="metric-value metric-value-sm text-warning">
                                            <field name="variants_without_recipe_count" readonly="1"/>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-lg-2 col-md-4 col-6">
                                <button name="action_view_components" type="object" class="w-100 border-0 bg-transparent p-0">
                                    <div class="metric-card metric-card-sm">
                                        <div class="metric-label">Components</div>
                                        <div class="metric-value metric-value-sm">
                                            <field name="component_count" readonly="1"/>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-lg-2 col-md-4 col-6">
                                <div class="metric-card metric-card-sm" style="cursor: default;">
                                    <div class="metric-label text-success">Kitchen Made</div>
                                    <div class="metric-value metric-value-sm text-success">
                                        <field name="kitchen_made_count" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-6">
                                <div class="metric-card metric-card-sm" style="cursor: default;">
                                    <div class="metric-label text-primary">Buy &amp; Sell</div>
                                    <div class="metric-value metric-value-sm text-primary">
                                        <field name="buy_sell_count" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4 col-6">
                                <button name="action_view_waste" type="object" class="w-100 border-0 bg-transparent p-0">
                                    <div class="metric-card metric-card-sm">
                                        <div class="metric-label text-danger">Waste (Month)</div>
                                        <div class="metric-value metric-value-sm text-danger">
                                            <field name="waste_count" readonly="1"/>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-lg-2 col-md-4 col-6">
                                <button name="action_view_waste_analysis" type="object" class="w-100 border-0 bg-transparent p-0">
                                    <div class="metric-card metric-card-sm">
                                        <div class="metric-label text-warning">Waste Value</div>
                                        <div class="metric-value metric-value-sm text-warning">
                                            <field name="waste_value" readonly="1" widget="float" digits="[10,2]"/>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>

                        <!-- Consumption Section -->
                        <div class="consumption-card">
                            <h2 class="consumption-title">
                                <i class="fa fa-line-chart text-primary"/>
                                Consumption Overview
                            </h2>
                            <div class="row align-items-center">
                                <div class="col-md-4">
                                    <button name="action_view_this_month_consumption" type="object" class="border-0 bg-transparent p-0 text-start w-100">
                                        <div class="consumption-stat">
                                            <div class="consumption-label">This Month Value</div>
                                            <div class="consumption-value">
                                                <field name="this_month_consumption_value" readonly="1" widget="float" digits="[10,2]"/>
                                            </div>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-md-4">
                                    <button name="action_view_consumption_lines" type="object" class="border-0 bg-transparent p-0 text-start w-100">
                                        <div class="consumption-stat">
                                            <div class="consumption-label">Total Records</div>
                                            <div class="consumption-value">
                                                <field name="consumption_line_count" readonly="1"/>
                                            </div>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-md-4 text-end">
                                    <button name="action_consumption_report" type="object" class="btn-primary-action" style="width: auto; display: inline-block; padding: 12px 28px;">
                                        <i class="fa fa-file-text-o me-2"/> View Full Report
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Actions Grid -->
                        <div class="row g-4">
                            <!-- Recipes Card -->
                            <div class="col-xl-3 col-lg-6">
                                <div class="action-card">
                                    <div class="action-card-header">
                                        <i class="fa fa-book fa-lg text-primary"/>
                                        <h3 class="action-card-title">Recipes</h3>
                                    </div>
                                    <div class="action-card-body">
                                        <button name="action_add_menu_item" type="object" class="btn-primary-action">
                                            <i class="fa fa-plus me-2"/> New Menu Item
                                        </button>
                                        <div style="flex: 1;">
                                            <button name="action_view_recipes" type="object" class="btn-link-action">
                                                <i class="fa fa-list"/> All Recipes
                                            </button>
                                            <button name="action_view_pos_products" type="object" class="btn-link-action">
                                                <i class="fa fa-shopping-cart"/> POS Products
                                            </button>
                                            <button name="action_products_without_recipe" type="object" class="btn-link-action text-warning">
                                                <i class="fa fa-exclamation-triangle"/> Without Recipe
                                            </button>
                                            <button name="action_low_margin_recipes" type="object" class="btn-link-action text-danger">
                                                <i class="fa fa-arrow-circle-up"/> High Cost Items
                                            </button>
                                            <div class="link-separator"/>
                                            <button name="action_print_all_recipes" type="object" class="btn-link-action text-muted">
                                                <i class="fa fa-print"/> Print All Recipes
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Ingredients Card -->
                            <div class="col-xl-3 col-lg-6">
                                <div class="action-card">
                                    <div class="action-card-header">
                                        <i class="fa fa-leaf fa-lg text-success"/>
                                        <h3 class="action-card-title">Ingredients</h3>
                                    </div>
                                    <div class="action-card-body">
                                        <button name="action_add_ingredient" type="object" class="btn-primary-action btn-green">
                                            <i class="fa fa-plus me-2"/> New Ingredient
                                        </button>
                                        <button name="action_view_ingredients" type="object" class="btn-link-action">
                                            <i class="fa fa-list"/> All Ingredients
                                        </button>
                                        <div class="link-separator"/>
                                        <button name="action_add_component" type="object" class="btn-secondary-action">
                                            <i class="fa fa-plus me-2"/> New Component
                                        </button>
                                        <button name="action_view_components" type="object" class="btn-link-action">
                                            <i class="fa fa-puzzle-piece"/> View Components
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Inventory Card -->
                            <div class="col-xl-3 col-lg-6">
                                <div class="action-card">
                                    <div class="action-card-header">
                                        <i class="fa fa-cubes fa-lg text-warning"/>
                                        <h3 class="action-card-title">Inventory</h3>
                                    </div>
                                    <div class="action-card-body">
                                        <button name="action_new_stocktake" type="object" class="btn-primary-action btn-orange">
                                            <i class="fa fa-clipboard me-2"/> New Stocktake
                                        </button>
                                        <button name="action_view_stocktakes" type="object" class="btn-link-action">
                                            <i class="fa fa-list-alt"/> View Stocktakes
                                        </button>
                                        <div class="link-separator"/>
                                        <button name="action_new_waste" type="object" class="btn-secondary-action" style="background: #ffebee; color: #c62828;">
                                            <i class="fa fa-trash me-2"/> Record Waste
                                        </button>
                                        <button name="action_view_waste" type="object" class="btn-link-action text-danger">
                                            <i class="fa fa-trash-o"/> View Waste
                                        </button>
                                        <button name="action_view_waste_analysis" type="object" class="btn-link-action text-muted">
                                            <i class="fa fa-bar-chart"/> Waste Analysis
                                        </button>
                                        <button name="action_view_boms" type="object" class="btn-link-action text-muted">
                                            <i class="fa fa-sitemap"/> View BOMs
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Variants &amp; Settings Card -->
                            <div class="col-xl-3 col-lg-6">
                                <div class="action-card">
                                    <div class="action-card-header">
                                        <i class="fa fa-clone fa-lg text-purple"/>
                                        <h3 class="action-card-title">Variants &amp; Config</h3>
                                    </div>
                                    <div class="action-card-body">
                                        <button name="action_setup_variant_recipes" type="object" class="btn-primary-action btn-purple">
                                            <i class="fa fa-magic me-2"/> Setup Variants
                                        </button>
                                        <button name="action_edit_variant_recipes" type="object" class="btn-link-action">
                                            <i class="fa fa-edit"/> Edit Variant Recipes
                                        </button>
                                        <button name="action_variants_without_recipe" type="object" class="btn-link-action text-warning">
                                            <i class="fa fa-exclamation"/> Missing Recipes
                                        </button>
                                        <button name="action_view_attributes" type="object" class="btn-link-action text-muted">
                                            <i class="fa fa-tags"/> Attributes
                                        </button>
                                        <div class="link-separator"/>
                                        <button name="action_open_settings" type="object" class="btn-secondary-action">
                                            <i class="fa fa-cog me-2"/> Settings
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action to open dashboard -->
    <record id="action_recipe_dashboard_server" model="ir.actions.server">
        <field name="name">Recipe Dashboard</field>
        <field name="model_id" ref="model_recipe_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = env['recipe.dashboard'].action_open_dashboard()</field>
    </record>

</odoo>
