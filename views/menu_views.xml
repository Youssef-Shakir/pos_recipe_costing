    <menuitem id="menu_inventory_section"
              name="Inventory"
              parent="menu_recipe_costing_root"
              sequence="40"/>

    <menuitem id="menu_ingredient_stocktake"
              name="Stocktake"
              parent="menu_inventory_section"
              action="action_ingredient_stocktake"
              sequence="10"/>

    <menuitem id="menu_ingredient_waste"
              name="Waste Records"
              parent="menu_inventory_section"
              action="action_ingredient_waste"
              sequence="20"/>

    <menuitem id="menu_waste_analysis"
              name="Waste Analysis"
              parent="menu_inventory_section"
              action="action_waste_analysis"
              sequence="30"/>

    <menuitem id="menu_bom_list"
              name="BOMs / Kits"
              parent="menu_inventory_section"
              action="action_recipe_bom_list"
              sequence="40"/>

    <!-- 6. Reports Section -->
    <menuitem id="menu_reports_section"
              name="Reports"
              parent="menu_recipe_costing_root"
              sequence="50"/>

    <menuitem id="menu_consumption_report"
              name="Consumption Report"
              parent="menu_reports_section"
              action="action_consumption_report_wizard"
              sequence="10"/>

    <menuitem id="menu_consumption_lines"
              name="Consumption History"
              parent="menu_reports_section"
              action="action_consumption_lines"
              sequence="20"/>

    <menuitem id="menu_ingredient_cost_history"
              name="Ingredient Cost History"
              parent="menu_reports_section"
              action="action_ingredient_cost_history"
              sequence="30"/>

    <menuitem id="menu_recipe_cost_history"
              name="Recipe Cost History"
              parent="menu_reports_section"
              action="action_recipe_cost_history"
              sequence="40"/>

    <!-- 7. Configuration Section -->
    <menuitem id="menu_config_section"
              name="Configuration"
              parent="menu_recipe_costing_root"
              sequence="60"/>

    <menuitem id="menu_product_attributes"
              name="Product Attributes"
              parent="menu_config_section"
              action="action_product_attribute_recipe"
              sequence="10"/>

    <menuitem id="menu_recipe_settings"
              name="Settings"
              parent="menu_config_section"
              action="action_recipe_config_settings"
              sequence="20"/>

</odoo>
