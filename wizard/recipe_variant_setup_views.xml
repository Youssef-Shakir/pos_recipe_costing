<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recipe_variant_setup_form" model="ir.ui.view">
        <field name="name">recipe.variant.setup.form</field>
        <field name="model">recipe.variant.setup</field>
        <field name="arch" type="xml">
            <form string="Setup Recipes for Variants">
                <sheet>
                    <!-- Header with state indicator -->
                    <div class="oe_title" invisible="state != 'preview'">
                        <h2>
                            <span class="badge bg-info">Preview Mode</span>
                            Review the recipes that will be created
                        </h2>
                    </div>

                    <!-- ============================================================ -->
                    <!-- SETUP STATE -->
                    <!-- ============================================================ -->
                    <div invisible="state != 'setup'">

                        <!-- Product Selection Group -->
                        <group string="Product Configuration" name="product_config">
                            <group>
                                <field name="product_tmpl_id"
                                       placeholder="Select a product with variants..."/>
                                <field name="recipe_type"/>
                                <field name="portion_size"/>
                            </group>
                            <group>
                                <field name="setup_mode" widget="radio"
                                       invisible="not product_tmpl_id"/>
                            </group>
                        </group>

                        <!-- Quick Setup Info Banner -->
                        <div class="alert alert-success mb-3" role="alert"
                             invisible="setup_mode != 'quick' or not product_tmpl_id">
                            <i class="fa fa-bolt me-2"/>
                            <strong>Quick Setup Mode Active:</strong>
                            Extra ingredient lines have been auto-created for each attribute value.
                            Just fill in the ingredients and quantities.
                        </div>

                        <!-- Variant Selection Section -->
                        <group string="Select Variants" name="variant_selection"
                               invisible="not product_tmpl_id">
                            <div class="row mb-2" colspan="2">
                                <div class="col-12">
                                    <button name="action_select_all_variants" type="object"
                                            string="Select All" class="btn-link btn-sm"
                                            icon="fa-check-square-o"/>
                                    <button name="action_deselect_all_variants" type="object"
                                            string="Deselect All" class="btn-link btn-sm ms-2"
                                            icon="fa-square-o"/>
                                    <span class="ms-3 text-muted">
                                        <field name="selected_count" readonly="1" class="oe_inline"/>
                                        variant(s) selected
                                    </span>
                                </div>
                            </div>
                            <field name="selected_variant_ids"
                                   nolabel="1" colspan="2"
                                   widget="many2many_checkboxes"
                                   domain="[('product_tmpl_id', '=', product_tmpl_id)]"/>
                        </group>

                        <!-- Warning for existing recipes -->
                        <div class="alert alert-warning mb-3" role="alert"
                             invisible="not existing_recipe_variant_ids">
                            <i class="fa fa-exclamation-triangle me-2"/>
                            <strong>Already have recipes (will be skipped):</strong>
                            <field name="existing_recipe_variant_ids"
                                   widget="many2many_tags" readonly="1" nolabel="1"
                                   class="ms-2"/>
                        </div>

                        <!-- Ingredients Notebook -->
                        <notebook invisible="not product_tmpl_id">

                            <!-- TAB 1: Base Ingredients -->
                            <page string="Base Ingredients" name="base_ingredients"
                                  badge="summary_total_base_ingredients">
                                <div class="alert alert-info mb-3" role="alert">
                                    <i class="fa fa-info-circle me-2"/>
                                    <strong>Base ingredients are added to every recipe.</strong>
                                    Include common items that all variants share (e.g., espresso, water, base syrup).
                                </div>

                                <group col="4" name="base_settings">
                                    <field name="copy_from_recipe_id"
                                           string="Load from Existing Recipe"
                                           domain="[('product_tmpl_id', '=', product_tmpl_id)]"
                                           placeholder="Optional - copy ingredients from another recipe"
                                           colspan="2"/>
                                    <div colspan="2"/>
                                </group>

                                <field name="ingredient_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id"
                                               context="{'default_is_ingredient': True}"
                                               options="{'no_create': False}"/>
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                        <field name="unit_cost" readonly="1" optional="show"/>
                                        <field name="cost" readonly="1" widget="monetary"
                                               sum="Total Base Cost" optional="show"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>

                            <!-- TAB 2: Variant-Specific Extras -->
                            <page string="Variant-Specific Extras" name="extras"
                                  badge="summary_total_extra_rules">
                                <div class="alert alert-info mb-3" role="alert">
                                    <i class="fa fa-info-circle me-2"/>
                                    <strong>Rule-based ingredient assignment:</strong>
                                    Each row defines a rule: "When a variant has attribute value X, add ingredient Y."
                                    Rules are applied automatically to all matching variants.
                                </div>

                                <div class="alert alert-secondary mb-3" role="alert">
                                    <strong>Example for a Latte product:</strong>
                                    <div class="row mt-2">
                                        <div class="col-md-4">
                                            <strong>Milk Type:</strong>
                                            <ul class="mb-0 small">
                                                <li>Oat Milk -> Oat Milk 150ml</li>
                                                <li>Almond Milk -> Almond Milk 150ml</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-4">
                                            <strong>Shot Size:</strong>
                                            <ul class="mb-0 small">
                                                <li>Double Shot -> Espresso 18g</li>
                                                <li>Triple Shot -> Espresso 27g</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-4">
                                            <strong>Flavor:</strong>
                                            <ul class="mb-0 small">
                                                <li>Vanilla -> Vanilla Syrup 10ml</li>
                                                <li>Hazelnut -> Hazelnut Syrup 10ml</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <group>
                                    <button name="action_auto_populate_extras" type="object"
                                            string="Auto-Populate All Attribute Values"
                                            class="btn-secondary"
                                            icon="fa-magic"
                                            help="Creates one row per attribute value. Fill in ingredients manually."/>
                                </group>

                                <field name="available_attribute_value_ids" invisible="1"/>
                                <field name="extra_line_ids" nolabel="1">
                                    <list editable="bottom" default_order="attribute_id, sequence">
                                        <field name="sequence" widget="handle"/>
                                        <field name="attribute_id"
                                               string="Attribute"
                                               readonly="1"
                                               optional="show"
                                               decoration-bf="1"/>
                                        <field name="attribute_value_id"
                                               string="When Value Is"
                                               domain="[('id', 'in', parent.available_attribute_value_ids)]"/>
                                        <field name="product_id"
                                               string="Add Ingredient"
                                               context="{'default_is_ingredient': True}"
                                               options="{'no_create': False}"/>
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                        <field name="unit_cost" readonly="1" optional="show"/>
                                        <field name="cost" readonly="1" widget="monetary" optional="show"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>

                            <!-- TAB 3: Live Preview -->
                            <page string="Preview" name="preview_tab"
                                  invisible="not selected_variant_ids">
                                <div class="alert alert-light mb-3" role="alert">
                                    <i class="fa fa-eye me-2"/>
                                    <strong>Live Preview:</strong>
                                    See exactly what ingredients each variant recipe will contain.
                                </div>

                                <field name="preview_line_ids" nolabel="1" readonly="1">
                                    <list create="false" delete="false" edit="false"
                                          decoration-info="total_ingredient_count > 0">
                                        <field name="variant_name" string="Variant"/>
                                        <field name="base_ingredients_display" string="Base Ingredients"/>
                                        <field name="extra_ingredients_display" string="Extra Ingredients"
                                               decoration-success="extra_ingredients_display != '-'"/>
                                        <field name="total_ingredient_count" string="Total"/>
                                    </list>
                                </field>
                            </page>

                        </notebook>

                        <!-- Quick Summary Stats (always visible when product selected) -->
                        <group string="Summary" name="quick_summary"
                               invisible="not product_tmpl_id" col="4">
                            <div class="row" colspan="4">
                                <div class="col-md-3 text-center">
                                    <div class="border rounded p-3 bg-light">
                                        <h3 class="mb-0">
                                            <field name="summary_total_variants" readonly="1" class="oe_inline"/>
                                        </h3>
                                        <small class="text-muted">Recipes to Create</small>
                                    </div>
                                </div>
                                <div class="col-md-3 text-center">
                                    <div class="border rounded p-3 bg-light">
                                        <h3 class="mb-0">
                                            <field name="summary_total_base_ingredients" readonly="1" class="oe_inline"/>
                                        </h3>
                                        <small class="text-muted">Base Ingredients</small>
                                    </div>
                                </div>
                                <div class="col-md-3 text-center">
                                    <div class="border rounded p-3 bg-light">
                                        <h3 class="mb-0">
                                            <field name="summary_total_extra_rules" readonly="1" class="oe_inline"/>
                                        </h3>
                                        <small class="text-muted">Extra Rules</small>
                                    </div>
                                </div>
                                <div class="col-md-3 text-center">
                                    <div class="border rounded p-3 bg-light">
                                        <h3 class="mb-0">
                                            <field name="summary_estimated_cost" readonly="1"
                                                   widget="monetary" class="oe_inline"/>
                                        </h3>
                                        <small class="text-muted">Est. Base Cost</small>
                                    </div>
                                </div>
                            </div>
                        </group>

                    </div>

                    <!-- ============================================================ -->
                    <!-- PREVIEW STATE -->
                    <!-- ============================================================ -->
                    <div invisible="state != 'preview'">
                        <field name="summary_html" readonly="1" nolabel="1"/>

                        <separator string="Detailed Preview"/>
                        <field name="preview_line_ids" nolabel="1" readonly="1">
                            <list create="false" delete="false" edit="false"
                                  decoration-info="total_ingredient_count > 0">
                                <field name="variant_name" string="Variant"/>
                                <field name="base_ingredients_display" string="Base Ingredients"/>
                                <field name="extra_ingredients_display" string="Extra Ingredients"
                                       decoration-success="extra_ingredients_display != '-'"/>
                                <field name="total_ingredient_count" string="Total Items"/>
                            </list>
                        </field>
                    </div>

                    <!-- Hidden state field -->
                    <field name="state" invisible="1"/>

                </sheet>

                <footer>
                    <!-- Setup state buttons -->
                    <button name="action_go_to_preview" type="object"
                            string="Review &amp; Confirm" class="btn-primary"
                            invisible="state != 'setup' or selected_count == 0"
                            icon="fa-arrow-right"/>
                    <button name="action_create_recipes" type="object"
                            string="Create Recipes Now" class="btn-secondary"
                            invisible="state != 'setup' or selected_count == 0"
                            icon="fa-plus"
                            confirm="This will create recipes immediately. Continue?"/>

                    <!-- Preview state buttons -->
                    <button name="action_back_to_setup" type="object"
                            string="Back to Setup" class="btn-secondary"
                            invisible="state != 'preview'"
                            icon="fa-arrow-left"/>
                    <button name="action_create_recipes" type="object"
                            string="Confirm &amp; Create Recipes" class="btn-primary"
                            invisible="state != 'preview'"
                            icon="fa-check"/>

                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_recipe_variant_setup" model="ir.actions.act_window">
        <field name="name">Setup Variant Recipes</field>
        <field name="res_model">recipe.variant.setup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
